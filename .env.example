# --- IB Gateway connection ---
IBKR_HOST=localhost
IBKR_PORT=5000
ACCOUNT_ID=

# --- Safety ---
# Keep true until you have validated the strategy extensively in paper trading.
# When true, orders are refused unless ACCOUNT_ID looks like an IBKR paper account (starts with "DU").
PAPER_MODE=true
# To ever trade a real account, set PAPER_MODE=false AND this to exactly I_UNDERSTAND_THE_RISK.
LIVE_TRADING_CONFIRM=

# Master switch for the fully automated loop. Off by default — drive /cycle manually
# (e.g. from a cron job or by hand) until you trust the results.
AUTOTRADE_ENABLED=false
AUTOTRADE_INTERVAL_MS=300000

# --- News sentiment ---
# Optional. Without it, sentiment falls back to a crude keyword scan over Yahoo Finance
# RSS headlines — fine for development, not a real sentiment model.
FINNHUB_API_KEY=

# --- Risk limits ---
MAX_POSITION_PCT=0.05
MAX_OPEN_POSITIONS=5
MAX_TRADES_PER_DAY=10
DAILY_LOSS_LIMIT_PCT=0.03
STOP_LOSS_PCT=0.02
TAKE_PROFIT_PCT=0.04
SHORT_ENABLED=false

# --- Signal thresholds ---
MOMENTUM_THRESHOLD=0.005
SENTIMENT_THRESHOLD=0.2
BAR_PERIOD=1d
BAR_SIZE=5min

# --- Hybrid agent (LLM investigates, rules decide — see lib/agent/) ---
# Required for the agent gate to do anything besides fail safe to HOLD.
# Two ways to authenticate — set ONE of these pairs:
#   (a) GCP_PROJECT_ID + GCP_REGION: uses Claude via Vertex AI with GCP
#       Application Default Credentials (gcloud auth application-default
#       login locally; automatic via the service account on Cloud Run).
#       No separate Anthropic key needed. Requires enabling the Claude
#       models in Vertex AI Model Garden for this GCP project first.
#   (b) ANTHROPIC_API_KEY: calls the Anthropic API directly instead.
# If GCP_PROJECT_ID is set, it takes priority over ANTHROPIC_API_KEY.
GCP_PROJECT_ID=
GCP_REGION=us-east5
ANTHROPIC_API_KEY=
# Only needed when running OUTSIDE GCP (e.g. the Hostinger VPS via
# docker-compose) with GCP_PROJECT_ID set — path to a downloaded GCP service
# account key JSON with the "Vertex AI User" role. On Cloud Run, leave this
# unset; the service account attached to the service provides credentials
# automatically.
GOOGLE_APPLICATION_CREDENTIALS=
AGENT_GATE_ENABLED=true
AGENT_MODEL=claude-opus-5-5

# --- Graduation gate (see lib/graduation/graduationGate.js) ---
# Hard precondition, on top of PAPER_MODE=false + LIVE_TRADING_CONFIRM, before
# ANY real-money order is allowed: the latest backtest must have passed its
# gate AND this many clean paper-trading days must be on record.
GRADUATION_MIN_PAPER_DAYS=14

# --- Passive portfolio (long-term dividend/ETF book — see lib/passive/) ---
# Dry-run by default; must be explicitly true to execute real rebalance orders.
PASSIVE_AUTOTRADE_ENABLED=false
REBALANCE_DRIFT_THRESHOLD_PCT=0.05
REBALANCE_MIN_TRADE_VALUE=50
REBALANCE_MIN_INTERVAL_DAYS=30

# --- Screener (screener-server.js, separate service — see README's GCP section) ---
# Optional. Without it, dividend criteria are skipped (technical-only scoring).
FMP_API_KEY=
# Comma-separated tickers. Omit to use the built-in default universe (lib/screener/universe.js).
SCREENER_UNIVERSE=
SCREENER_WEIGHT_TECHNICAL=0.5
SCREENER_WEIGHT_DIVIDEND=0.5
# 'file' (default, local/dev) or 'firestore' (required for a real Cloud Run deployment).
RESULTS_STORE=file
# Shared secret Cloud Scheduler sends when triggering POST /run. Leave unset only for local/dev.
SCREENER_RUN_TOKEN=
