# --- IB Gateway connection ---
IBKR_HOST=localhost
IBKR_PORT=5000
ACCOUNT_ID=

# --- Safety ---
# Keep true until you have validated the strategy extensively in paper trading.
# When true, orders are refused unless ACCOUNT_ID looks like an IBKR paper account (starts with "DU").
PAPER_MODE=true
# To ever trade a real account, set PAPER_MODE=false AND this to exactly I_UNDERSTAND_THE_RISK.
LIVE_TRADING_CONFIRM=

# Master switch for the fully automated loop. Off by default — drive /cycle manually
# (e.g. from a cron job or by hand) until you trust the results.
AUTOTRADE_ENABLED=false
AUTOTRADE_INTERVAL_MS=300000

# --- News sentiment ---
# Optional. Without it, sentiment falls back to a crude keyword scan over Yahoo Finance
# RSS headlines — fine for development, not a real sentiment model.
FINNHUB_API_KEY=

# --- Risk limits ---
MAX_POSITION_PCT=0.05
MAX_OPEN_POSITIONS=5
MAX_TRADES_PER_DAY=10
DAILY_LOSS_LIMIT_PCT=0.03
STOP_LOSS_PCT=0.02
TAKE_PROFIT_PCT=0.04
SHORT_ENABLED=false

# --- Signal thresholds ---
MOMENTUM_THRESHOLD=0.005
SENTIMENT_THRESHOLD=0.2
BAR_PERIOD=1d
BAR_SIZE=5min
